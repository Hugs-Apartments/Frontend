# Hugs Luxury Apartments — frontend environment variables
# Copy to .env.local and fill in when the backend is ready.
# The frontend currently runs entirely on mock data, so these are optional.

# Supabase (see src/lib/supabaseClient.js)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paystack public key (see src/lib/paystack.js)
VITE_PAYSTACK_PUBLIC_KEY=

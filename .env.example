# Hugs Luxury Apartments — frontend environment
# Copy to .env.local. The frontend runs on mock data until VITE_API_URL is set.
#
# NOTE: No Supabase keys ever live in the frontend. All database access happens
# on the backend. The only values allowed here are the API URL and the Paystack
# PUBLIC key (safe to expose by design).

VITE_API_URL=http://localhost:4000

# VITE_PAYSTACK_PUBLIC_KEY=pk_live_37617a38bec498dc66448202fb07b1e89b5f6fac
VITE_PAYSTACK_PUBLIC_KEY=pk_test_REPLACE_WITH_YOUR_TEST_KEY
